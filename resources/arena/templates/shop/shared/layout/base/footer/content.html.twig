{% set arena_services = [
    {key: 'support', url: path('sylius_shop_contact_request'), icon: 'M4 13v-1a8 8 0 0 1 16 0v1M4 13h3v6H5a1 1 0 0 1-1-1zM20 13h-3v6h2a1 1 0 0 0 1-1zM17 19c0 1.5-2 2.5-5 2.5'},
    {key: 'refunds', url: path('sylius_shop_account_dashboard'), icon: 'M4 12a8 8 0 1 0 2.6-5.9M4 4v4h4M12 8v4l3 2'},
    {key: 'library', url: path('sylius_shop_account_dashboard'), icon: 'M4 4h4v16H4zM10 4h4v16h-4zM16.5 4.5l3.8 1-3.9 15-3.8-1'},
] %}

<footer class="arena-footer">
    <div class="arena-services">
        <div class="container">
            <ul class="arena-services__items" role="list">
                {% for service in arena_services %}
                    <li class="arena-services__item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ service.icon }}"/></svg>
                        <div>
                            <p class="arena-services__name">{{ ('arena.footer.services.' ~ service.key ~ '.title')|trans({}, 'arena') }}</p>
                            <p class="arena-services__text">{{ ('arena.footer.services.' ~ service.key ~ '.text')|trans({}, 'arena') }}</p>
                            <a class="arena-link-arrow" href="{{ service.url }}">{{ ('arena.footer.services.' ~ service.key ~ '.cta')|trans({}, 'arena') }}</a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container arena-footer__main">
        <div class="arena-footer__brand">
            {% include 'shop/shared/layout/brand/logo.html.twig' with {variant: 'footer'} %}
            <p>{{ 'arena.footer.tagline'|trans({}, 'arena') }}</p>
        </div>
        <div class="row">
            {% hook 'content' %}
        </div>
        <div class="arena-ratings">
            <ul class="arena-ratings__badges" role="list" aria-label="{{ 'arena.footer.ratings.label'|trans({}, 'arena') }}">
                {% for age in [3, 7, 12, 16, 18] %}
                    <li class="arena-age arena-age--{{ age }}">{{ age }}</li>
                {% endfor %}
            </ul>
            <p>{{ 'arena.footer.ratings.text'|trans({}, 'arena') }}</p>
        </div>
    </div>
</footer>
