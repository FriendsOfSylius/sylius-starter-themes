{# Groove pressing of the month: an audiophile reissue presented like a collector's sheet — the sleeve and its coloured
   record, the pressing references (label, catalogue number, matrix, mastering, plant, edition), the tracklist, the
   editions in stock and what to play it on: what a Sylius product page carries through attributes, variants and
   associations. #}
<section id="groove-release" class="groove-release" aria-labelledby="groove-release-title">
    <div class="container">
        <div class="groove-release__grid">
            <figure class="groove-release__visual">
                <div class="groove-release__panel">
                    <div class="groove-release__stage" role="img" aria-label="{{ 'groove.release.illustration'|trans({}, 'groove') }}">
                        <div class="groove-release__record"></div>
                        <svg class="groove-release__sleeve groove-cover" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
                            <rect class="groove-cover__paper" width="400" height="400"/>
                            {% for r in [300, 236, 172, 108] %}
                                <circle class="{{ loop.index is odd ? 'groove-cover__electric' : 'groove-cover__mint' }}" cx="400" cy="400" r="{{ r }}"/>
                            {% endfor %}
                            <circle class="groove-cover__acid" cx="400" cy="400" r="54"/>
                            <rect class="groove-cover__ink" x="28" y="28" width="290" height="96"/>
                            <text class="groove-cover__title groove-cover__title--paper" x="42" y="78">Blue Hours</text>
                            <text class="groove-cover__subtitle groove-cover__title--paper" x="44" y="104">MARLOWE QUARTET</text>
                        </svg>
                    </div>
                    <span class="groove-release__sticker">{{ 'groove.release.number'|trans({}, 'groove')|raw }}</span>
                </div>
                <figcaption class="groove-release__caption">
                    <span>{{ 'groove.release.caption'|trans({}, 'groove') }}</span>
                    <span class="groove-ref">{{ 'groove.release.specs.catalogue.value'|trans({}, 'groove') }}</span>
                </figcaption>
            </figure>

            <div class="groove-release__sheet">
                <p class="groove-eyebrow">{{ 'groove.release.eyebrow'|trans({}, 'groove') }}</p>
                <h2 id="groove-release-title">{{ 'groove.release.title'|trans({}, 'groove')|raw }}</h2>
                <p class="groove-release__lead">{{ 'groove.release.lead'|trans({}, 'groove') }}</p>

                <dl class="groove-specs">
                    {% for spec in ['label', 'catalogue', 'matrix', 'mastering', 'plant', 'format', 'edition', 'condition'] %}
                        <div>
                            <dt>{{ ('groove.release.specs.' ~ spec ~ '.label')|trans({}, 'groove') }}</dt>
                            <dd{% if spec in ['catalogue', 'matrix'] %} class="groove-ref"{% endif %}>{{ ('groove.release.specs.' ~ spec ~ '.value')|trans({}, 'groove') }}</dd>
                        </div>
                    {% endfor %}
                </dl>

                <div class="groove-tracklist">
                    {% for side in ['a', 'b'] %}
                        <div>
                            <p class="groove-variants__label">{{ ('groove.release.side_' ~ side)|trans({}, 'groove') }}</p>
                            <ol role="list">
                                {% for n in 1..3 %}
                                    <li>
                                        <span class="groove-tracklist__position">{{ side|upper }}{{ n }}</span>
                                        <span class="groove-tracklist__title">{{ ('groove.release.tracks.' ~ side ~ n ~ '.title')|trans({}, 'groove') }}</span>
                                        <span class="groove-tracklist__time">{{ ('groove.release.tracks.' ~ side ~ n ~ '.time')|trans({}, 'groove') }}</span>
                                    </li>
                                {% endfor %}
                            </ol>
                        </div>
                    {% endfor %}
                </div>

                <div class="groove-variants">
                    <p class="groove-variants__label">{{ 'groove.release.editions'|trans({}, 'groove') }}</p>
                    <ul class="groove-pressings" role="list">
                        {% for edition in ['black', 'clear', 'blue'] %}
                            <li class="groove-pressing groove-pressing--{{ edition }}{{ edition == 'blue' ? ' is-selected' : '' }}">
                                <span class="groove-pressing__disc" aria-hidden="true"></span>
                                <span class="groove-pressing__name">{{ ('groove.release.edition.' ~ edition ~ '.name')|trans({}, 'groove') }}</span>
                                <span class="groove-pressing__meta">{{ ('groove.release.edition.' ~ edition ~ '.meta')|trans({}, 'groove') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <div class="groove-pairs">
                    <p class="groove-variants__label">{{ 'groove.release.pairs'|trans({}, 'groove') }}</p>
                    <ul role="list">
                        {% for item in ['turntable', 'phono', 'cleaning'] %}
                            <li>
                                <span class="groove-pairs__name">{{ ('groove.release.pair.' ~ item ~ '.name')|trans({}, 'groove') }}</span>
                                <span class="groove-pairs__meta">{{ ('groove.release.pair.' ~ item ~ '.meta')|trans({}, 'groove') }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <a class="btn btn-primary" href="#groove-latest-products">{{ 'groove.release.cta'|trans({}, 'groove') }}</a>
            </div>
        </div>
    </div>
</section>
