{# Groove promise: four commitments of the shop on a black band, each opened by a hot pink pictogram. #}
{% set groove_promises = [
    {key: 'checked', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM12 6.5a5.5 5.5 0 0 1 5.5 5.5'},
    {key: 'mailers', icon: 'M3 7l9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10'},
    {key: 'fridays', icon: 'M4 5h16v15H4zM4 10h16M9 3v4M15 3v4M10 14l2 2 4-4'},
    {key: 'preorders', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2'},
] %}

<section id="groove-promise" class="groove-promise" aria-labelledby="groove-promise-title">
    <div class="container">
        <h2 id="groove-promise-title" class="visually-hidden">{{ 'groove.promise.title'|trans({}, 'groove') }}</h2>
        <ul class="groove-promise__items" role="list">
            {% for promise in groove_promises %}
                <li class="groove-promise__item">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ promise.icon }}"/></svg>
                    <div>
                        <p class="groove-promise__name">{{ ('groove.promise.' ~ promise.key ~ '.title')|trans({}, 'groove') }}</p>
                        <p class="groove-promise__text">{{ ('groove.promise.' ~ promise.key ~ '.text')|trans({}, 'groove') }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
