{% set drive_services = [
    {key: 'pickup', url: path('sylius_shop_homepage') ~ '#drive-how', icon: 'M3 13.5 5 8a2 2 0 0 1 1.9-1.3h10.2A2 2 0 0 1 19 8l2 5.5V18a1 1 0 0 1-1 1h-1.5a1 1 0 0 1-1-1v-1h-11v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1ZM3 13.5h18'},
    {key: 'account', url: path('sylius_shop_account_dashboard'), icon: 'M9 5h10M9 12h10M9 19h10M4.5 5h.01M4.5 12h.01M4.5 19h.01'},
    {key: 'help', url: path('sylius_shop_contact_request'), icon: 'M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2zM20 14a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2zM17 16v1a3 3 0 0 1-3 3h-2'},
] %}

<footer class="drive-footer">
    <div class="drive-services">
        <div class="container">
            <ul class="drive-services__list" role="list">
                {% for service in drive_services %}
                    <li class="drive-services__item">
                        <span class="drive-services__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false"><path d="{{ service.icon }}"/></svg>
                        </span>
                        <span class="drive-services__body">
                            <span class="drive-services__name">{{ ('drive.footer.services.' ~ service.key ~ '.title')|trans({}, 'drive') }}</span>
                            <span class="drive-services__text">{{ ('drive.footer.services.' ~ service.key ~ '.text')|trans({}, 'drive') }}</span>
                            <a class="drive-services__link" href="{{ service.url }}">{{ ('drive.footer.services.' ~ service.key ~ '.cta')|trans({}, 'drive') }}</a>
                        </span>
                    </li>
                {% endfor %}
                <li class="drive-services__item drive-services__item--hours">
                    <span class="drive-services__name">{{ 'drive.footer.hours.title'|trans({}, 'drive') }}</span>
                    <dl class="drive-hours">
                        {% for row in 1..3 %}
                            <div>
                                <dt>{{ ('drive.footer.hours.row_' ~ row ~ '.days')|trans({}, 'drive') }}</dt>
                                <dd>{{ ('drive.footer.hours.row_' ~ row ~ '.time')|trans({}, 'drive') }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                </li>
            </ul>
        </div>
    </div>
    <div class="container drive-footer__main">
        <div class="drive-footer__brand">
            {% include 'shop/shared/layout/brand/logo.html.twig' with {variant: 'footer'} %}
            <p>{{ 'drive.footer.tagline'|trans({}, 'drive') }}</p>
        </div>
        <div class="row">
            {% hook 'content' %}
        </div>
    </div>
</footer>
