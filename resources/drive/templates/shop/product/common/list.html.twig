{% set drive_list_key = hookable_metadata.configuration['test_attribute']|default('latest-products') %}
{% set drive_eyebrows = {'latest-products': 'drive.products.eyebrow.latest'} %}

<section id="drive-{{ drive_list_key }}" class="drive-products drive-products--{{ drive_list_key }}">
    <div class="container" role="region" aria-labelledby="{{ drive_list_key ~ '-heading' }}">
        <div class="drive-section-head drive-section-head--row">
            <div>
                {% if drive_eyebrows[drive_list_key] is defined %}
                    <p class="drive-eyebrow">{{ drive_eyebrows[drive_list_key]|trans({}, 'drive') }}</p>
                {% endif %}
                <h2 id="{{ drive_list_key ~ '-heading' }}">{{ hookable_metadata.configuration.title|default('sylius.ui.latest_products')|trans }}</h2>
            </div>
            <p class="drive-section-head__count">{{ 'drive.products.count'|trans({'%count%': latest_products|length}, 'drive') }}</p>
        </div>

        <div {{ sylius_test_html_attribute(hookable_metadata.configuration.test_attribute|default('latest-products')) }}>
            <div class="products-grid">
                {% for product in latest_products %}
                    <div>{{ component('sylius_shop:product:card', {product: product, template: hookable_metadata.configuration.product_template|default('@SyliusShop/product/common/card.html.twig'), hookableMetadata: hookable_metadata}) }}</div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
