{% if taxons|length > 0 %}
    <div class="col drive-checkout-nav">
        <nav class="navbar offcanvas-lg offcanvas-start offcanvas-wide p-0 drive-checkout-nav__menu" id="navbarNav" aria-label="{{ 'sylius.ui.taxon_navigation_desktop'|trans }}">
            <div class="offcanvas-header w-full">
                <h2 class="offcanvas-title fs-5">{{ 'drive.aisles.title'|trans({}, 'drive') }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#navbarNav" aria-label="{{ 'sylius.ui.close'|trans }}"></button>
            </div>
            <div class="offcanvas-body w-full py-0">
                <div class="navbar-nav drive-checkout-nav__links" {{ sylius_test_html_attribute('menu') }}>
                    {% hook 'menu' with { taxons, _prefixes: ['sylius_shop.base.header.navbar'] } %}
                </div>
            </div>
        </nav>
    </div>
{% endif %}
