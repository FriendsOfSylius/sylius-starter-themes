{# The trade account: how it works in three steps, next to the account card of a fictional customer, with its terms
   and its savings on the last order. #}
<section id="depot-account" class="depot-account" aria-labelledby="depot-account-title">
    <div class="container">
        <div class="depot-account__grid">
            <div class="depot-account__steps">
                <div class="depot-section-head">
                    <p class="depot-eyebrow">{{ 'depot.account.eyebrow'|trans({}, 'depot') }}</p>
                    <h2 id="depot-account-title">{{ 'depot.account.title'|trans({}, 'depot')|raw }}</h2>
                    <p class="depot-section-head__lead">{{ 'depot.account.lead'|trans({}, 'depot')|raw }}</p>
                </div>

                <ol class="depot-steps" role="list">
                    {% for step in 1..3 %}
                        <li class="depot-steps__item">
                            <span class="depot-steps__numeral" aria-hidden="true">{{ '%02d'|format(step) }}</span>
                            <div>
                                <p class="depot-steps__title">{{ ('depot.account.step_' ~ step ~ '.title')|trans({}, 'depot') }}</p>
                                <p class="depot-steps__text">{{ ('depot.account.step_' ~ step ~ '.text')|trans({}, 'depot') }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ol>

                <a class="btn btn-primary" href="{{ path('sylius_shop_register') }}">{{ 'depot.account.cta'|trans({}, 'depot') }}</a>
            </div>

            <aside class="depot-card" aria-labelledby="depot-card-title">
                <div class="depot-card__head">
                    {% include 'shop/homepage/crate.html.twig' with {class: 'depot-card__crate'} %}
                    <div>
                        <p class="depot-card__kicker">{{ 'depot.account.card.kicker'|trans({}, 'depot') }}</p>
                        <p id="depot-card-title" class="depot-card__title">{{ 'depot.account.card.title'|trans({}, 'depot') }}</p>
                    </div>
                    <span class="depot-card__status">{{ 'depot.account.card.status'|trans({}, 'depot') }}</span>
                </div>

                <dl class="depot-card__terms">
                    {% for term in ['payment', 'credit', 'users', 'delivery'] %}
                        <div>
                            <dt>{{ ('depot.account.card.' ~ term ~ '.label')|trans({}, 'depot') }}</dt>
                            <dd>{{ ('depot.account.card.' ~ term ~ '.value')|trans({}, 'depot') }}</dd>
                        </div>
                    {% endfor %}
                </dl>


                <p class="depot-card__saving">{{ 'depot.account.card.saving'|trans({}, 'depot')|raw }}</p>
            </aside>
        </div>
    </div>
</section>
