{# Arena promise: four player-first services next to the free membership card (level, XP bar and perks). #}
{% set arena_features = [
    {key: 'keys', icon: 'M7.5 6.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11zm0 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM12.5 10.5H22v3h-2v3h-3v-3h-4.5z'},
    {key: 'launch', icon: 'M12 2c3.5 2 5.5 5.6 5.5 9.5 0 1.6-.3 3-.9 4.3L19 18l-3 1-1.6-2.2a9 9 0 0 1-4.8 0L8 19l-3-1 2.4-2.2a10.6 10.6 0 0 1-.9-4.3C6.5 7.6 8.5 4 12 2zm0 6.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM10 20h4l-2 2.5z'},
    {key: 'price', icon: 'M3 12V4h8l10 10-8 8zm4.5-6a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM10 15l5-5 1.5 1.5-5 5z'},
    {key: 'boxed', icon: 'M3 7.5 12 3l9 4.5v9L12 21l-9-4.5zm2 1.6v6.2l6 3v-6.2zm8 9.2 6-3V9.1l-6 3zM6.3 7.6 12 10.4l5.7-2.8L12 4.8z'},
] %}

<section id="arena-promise" class="arena-promise" aria-labelledby="arena-promise-title">
    <div class="container">
        <div class="arena-promise__grid">
            <div class="arena-promise__features">
                <div class="arena-section-head">
                    <p class="arena-eyebrow">{{ 'arena.promise.eyebrow'|trans({}, 'arena') }}</p>
                    <h2 id="arena-promise-title">{{ 'arena.promise.title'|trans({}, 'arena')|raw }}</h2>
                    <p class="arena-section-head__lead">{{ 'arena.promise.lead'|trans({}, 'arena')|raw }}</p>
                </div>

                <ul class="arena-features" role="list">
                    {% for feature in arena_features %}
                        <li class="arena-features__item">
                            <span class="arena-features__icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ feature.icon }}"/></svg></span>
                            <p class="arena-features__title">{{ ('arena.promise.' ~ feature.key ~ '.title')|trans({}, 'arena') }}</p>
                            <p class="arena-features__text">{{ ('arena.promise.' ~ feature.key ~ '.text')|trans({}, 'arena') }}</p>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <aside class="arena-pass" aria-labelledby="arena-pass-title">
                <div class="arena-pass__head">
                    <p class="arena-pass__kicker">{{ 'arena.promise.pass.kicker'|trans({}, 'arena') }}</p>
                    <span class="arena-pass__tier">{{ 'arena.promise.pass.tier'|trans({}, 'arena') }}</span>
                </div>
                <p id="arena-pass-title" class="arena-pass__title">{{ 'arena.promise.pass.title'|trans({}, 'arena') }}</p>

                <div class="arena-pass__level">
                    <span class="arena-pass__badge" aria-hidden="true">27</span>
                    <div class="arena-pass__progress">
                        <p><span>{{ 'arena.promise.pass.level'|trans({}, 'arena') }}</span><span>{{ 'arena.promise.pass.xp'|trans({}, 'arena') }}</span></p>
                        <span class="arena-pass__bar" role="img" aria-label="{{ 'arena.promise.pass.xp'|trans({}, 'arena') }}"><span style="width: 72%"></span></span>
                    </div>
                </div>

                <ul class="arena-pass__perks" role="list">
                    {% for perk in 1..3 %}
                        <li>{{ ('arena.promise.pass.perk_' ~ perk)|trans({}, 'arena') }}</li>
                    {% endfor %}
                </ul>

                <a class="btn btn-primary w-100" href="{{ path('sylius_shop_register') }}">{{ 'arena.promise.pass.cta'|trans({}, 'arena') }}</a>
            </aside>
        </div>
    </div>
</section>
