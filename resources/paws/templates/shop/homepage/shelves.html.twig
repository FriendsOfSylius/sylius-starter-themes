{# Paws aisles: the six aisles of the shop, each on its pastel, with a drawing, its promise and its bestseller. #}
<section id="paws-aisles" class="paws-aisles" aria-labelledby="paws-aisles-title">
    <div class="container">
        <div class="paws-section-head paws-section-head--center">
            <p class="paws-eyebrow">{{ 'paws.aisles.eyebrow'|trans({}, 'paws') }}</p>
            <h2 id="paws-aisles-title">{{ 'paws.aisles.title'|trans({}, 'paws')|raw }}</h2>
            <p class="paws-section-head__lead">{{ 'paws.aisles.lead'|trans({}, 'paws') }}</p>
        </div>

        <ul class="paws-aisles__items" role="list">
            {% for aisle in ['food', 'treats', 'toys', 'accessories', 'beds', 'care'] %}
                <li class="paws-aisle paws-aisle--{{ aisle }}">
                    <svg class="paws-aisle__icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                        {% if aisle == 'food' %}
                            <path d="M8 30h48l-5 20a5 5 0 0 1-5 4H18a5 5 0 0 1-5-4z"/><path d="M14 30c2-8 9-13 18-13s16 5 18 13"/><circle cx="24" cy="24" r="2.5"/><circle cx="33" cy="21" r="2.5"/><circle cx="41" cy="25" r="2.5"/>
                        {% elseif aisle == 'treats' %}
                            <path d="M22 26l20 12M15 26a6 6 0 1 1 7-9 6 6 0 1 1 3 10L39 37a6 6 0 1 1 9 7 6 6 0 1 1-10 3L24 39a6 6 0 1 1-9-13z"/>
                        {% elseif aisle == 'toys' %}
                            <circle cx="32" cy="34" r="20"/><path d="M15 24c9 3 12 15 6 24M49 24c-9 3-12 15-6 24"/>
                        {% elseif aisle == 'accessories' %}
                            <path d="M10 30c0-9 10-14 22-14s22 5 22 14-10 14-22 14-22-5-22-14z"/><path d="M14 30c0-6 8-10 18-10s18 4 18 10"/><circle cx="32" cy="50" r="6"/><path d="M32 44v-0"/>
                        {% elseif aisle == 'beds' %}
                            <path d="M6 38c0-8 12-12 26-12s26 4 26 12-12 14-26 14S6 46 6 38z"/><path d="M16 38c0-4 7-6 16-6s16 2 16 6"/><path d="M40 18c2 2 6 2 8 0M46 10c2 2 6 2 8 0"/>
                        {% else %}
                            <rect x="10" y="28" width="30" height="12" rx="6"/><path d="M40 34h14M14 40v8M20 40v8M26 40v8M32 40v8"/><path d="M48 14c2 4 6 6 6 10a6 6 0 0 1-12 0c0-4 4-6 6-10z"/>
                        {% endif %}
                    </svg>
                    <p class="paws-aisle__name">{{ ('paws.aisles.' ~ aisle ~ '.name')|trans({}, 'paws') }}</p>
                    <p class="paws-aisle__promise">{{ ('paws.aisles.' ~ aisle ~ '.promise')|trans({}, 'paws') }}</p>
                    <p class="paws-aisle__text">{{ ('paws.aisles.' ~ aisle ~ '.text')|trans({}, 'paws') }}</p>
                    <p class="paws-aisle__bestseller">
                        <span>{{ 'paws.aisles.bestseller'|trans({}, 'paws') }}</span>
                        {{ ('paws.aisles.' ~ aisle ~ '.bestseller')|trans({}, 'paws') }}
                    </p>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
