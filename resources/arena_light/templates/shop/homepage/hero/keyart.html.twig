{# Original key art, daylight cut: a lone wanderer on a rocky spur, facing a pale ringed giant over a hazy alien range at sunrise. #}
<svg class="arena-keyart" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" role="img" aria-labelledby="arena-keyart-title" focusable="false">
    <title id="arena-keyart-title">{{ 'arena.hero.illustration'|trans({}, 'arena') }}</title>
    <defs>
        <linearGradient id="arena-keyart-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#6F97D9"/>
            <stop offset="0.32" stop-color="#B8CCEE"/>
            <stop offset="0.56" stop-color="#EEDDE6"/>
            <stop offset="0.68" stop-color="#FFC9A6"/>
            <stop offset="0.75" stop-color="#FFA466"/>
            <stop offset="0.84" stop-color="#E4C6C2"/>
        </linearGradient>
        <radialGradient id="arena-keyart-planet" cx="0.38" cy="0.3" r="0.8">
            <stop offset="0" stop-color="#FFFFFF"/>
            <stop offset="0.5" stop-color="#DCE0F4"/>
            <stop offset="1" stop-color="#8790C2"/>
        </radialGradient>
        <radialGradient id="arena-keyart-glow" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0.6" stop-color="#FFFFFF" stop-opacity="0.7"/>
            <stop offset="0.78" stop-color="#C6F432" stop-opacity="0.22"/>
            <stop offset="1" stop-color="#C6F432" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="arena-keyart-beam" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.75"/>
            <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="arena-keyart-haze" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FF8A4C" stop-opacity="0"/>
            <stop offset="0.5" stop-color="#FF8A4C" stop-opacity="0.28"/>
            <stop offset="1" stop-color="#FF8A4C" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="arena-keyart-fade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#F2F4F8" stop-opacity="0"/>
            <stop offset="1" stop-color="#F2F4F8"/>
        </linearGradient>
        <filter id="arena-keyart-blur" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="40"/>
        </filter>
        <clipPath id="arena-keyart-disc">
            <circle cx="900" cy="300" r="186"/>
        </clipPath>
        <radialGradient id="arena-keyart-crescent" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.8"/>
            <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
        </radialGradient>
        <radialGradient id="arena-keyart-backlight" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.95"/>
            <stop offset="0.45" stop-color="#FFE2C4" stop-opacity="0.6"/>
            <stop offset="1" stop-color="#FFE2C4" stop-opacity="0"/>
        </radialGradient>
        <filter id="arena-keyart-haze-blur" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="14"/>
        </filter>
        <filter id="arena-keyart-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="6"/>
        </filter>
    </defs>

    <rect width="1600" height="900" fill="url(#arena-keyart-sky)"/>

    {# Nebula clouds. #}
    <g filter="url(#arena-keyart-blur)">
        <ellipse cx="420" cy="200" rx="380" ry="90" fill="#FFFFFF" opacity="0.8"/>
        <ellipse cx="1320" cy="250" rx="320" ry="110" fill="#FFFFFF" opacity="0.65"/>
        <ellipse cx="900" cy="570" rx="560" ry="90" fill="#FFB27A" opacity="0.45"/>
    </g>

    {# The pale ringed giant of the morning sky: banded surface, bright upper rim, ring passing in front. #}
    <g transform="rotate(-14 900 300)">
        <ellipse cx="900" cy="300" rx="330" ry="56" fill="none" stroke="#5A6488" stroke-opacity="0.22" stroke-width="12"/>
        <ellipse cx="900" cy="300" rx="372" ry="64" fill="none" stroke="#7FA300" stroke-opacity="0.35" stroke-width="2"/>
    </g>
    <circle cx="900" cy="300" r="250" fill="url(#arena-keyart-glow)"/>
    <circle cx="900" cy="300" r="186" fill="url(#arena-keyart-planet)"/>
    <g clip-path="url(#arena-keyart-disc)" fill="none" stroke-linecap="round">
        <ellipse cx="900" cy="250" rx="240" ry="26" stroke="#7C5CFF" stroke-opacity="0.12" stroke-width="14" transform="rotate(-14 900 300)"/>
        <ellipse cx="900" cy="315" rx="240" ry="30" stroke="#8FA4D8" stroke-opacity="0.25" stroke-width="22" transform="rotate(-14 900 300)"/>
        <ellipse cx="900" cy="372" rx="240" ry="28" stroke="#7C5CFF" stroke-opacity="0.1" stroke-width="10" transform="rotate(-14 900 300)"/>
        <circle cx="1010" cy="180" r="190" fill="url(#arena-keyart-crescent)" stroke="none"/>
    </g>
    <path d="M760 176a186 186 0 0 1 320 86" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" opacity="0.9" filter="url(#arena-keyart-soft)"/>
    <path d="M760 176a186 186 0 0 1 320 86" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round"/>
    <g transform="rotate(-14 900 300)">
        <path d="M570 300a330 56 0 0 0 660 0" fill="none" stroke="#5A6488" stroke-opacity="0.32" stroke-width="12"/>
        <path d="M528 300a372 64 0 0 0 744 0" fill="none" stroke="#7FA300" stroke-opacity="0.6" stroke-width="2"/>
    </g>

    {# A soft shaft of light falling on the spur. #}
    <path class="arena-keyart__beam" d="M872 470h56l90 180H782z" fill="url(#arena-keyart-beam)" filter="url(#arena-keyart-haze-blur)"/>

    {# Mountain ranges, from the farthest to the closest. #}
    <path d="M0 600l90-50 70 22 110-80 90 60 80-34 120 70 110-58 100 46 130-92 120 84 90-30 140 70 110-46 120 52 120-30v388H0z" fill="#A3ACD3" opacity="0.9"/>
    <rect y="540" width="1600" height="120" fill="url(#arena-keyart-haze)"/>
    <path d="M0 660l130-46 100 30 140-64 120 56 150-30 110 40 150-62 130 48 120-24 150 52 130-40 140 46 80-12v346H0z" fill="#717CAA"/>
    <path d="M0 735l170-40 160 28 190-52 150 40 210-30 170 34 190-46 180 40 180-22v253H0z" fill="#454F7E"/>

    <ellipse cx="886" cy="600" rx="150" ry="95" fill="url(#arena-keyart-backlight)"/>

    {# Rocky spur under the wanderer, and the cliff on the right. #}
    <path d="M640 900l70-150 60-64 52-22h110l60 34 70 80 70 122z" fill="#1E2440"/>
    <path d="M822 664h110l14 8H812z" fill="#FFFFFF" opacity="0.5"/>
    <path d="M1250 900l40-170 70-110 90-60 80-90 70-30v460z" fill="#262D4C"/>
    <path d="M1360 620l90-60 80-90 70-30" fill="none" stroke="#FFFFFF" stroke-opacity="0.45" stroke-width="2"/>

    {# The wanderer, cape in the wind, backlit by the sunrise. #}
    <g class="arena-keyart__hero" transform="translate(880 664) scale(1.7) translate(-880 -664)">
        <path d="M902 612C918 620 936 638 952 662L908 664z" fill="#0B0E16"/>
        <path d="M885 586c5.5 0 9 5 9 12l1 9c5 2 8 7 9 13l5 44h-48l5-44c1-6 4-11 9-13l1-9c0-7 3.5-12 9-12z" fill="#0B0E16"/>
        <path d="M876 598c0-7 3.5-12 9-12M866 620c1-6 4-11 9-13" fill="none" stroke="#FFFFFF" stroke-width="1.1" stroke-linecap="round" opacity="0.9"/>
        <path d="M862 572l-4 92" stroke="#0B0E16" stroke-width="2.6" stroke-linecap="round"/>
        <circle cx="862" cy="566" r="11" fill="#C6F432" opacity="0.45"/>
        <path d="M862 559l3.5 7-3.5 7-3.5-7z" fill="#9CC41A"/>
    </g>

    {# Drifting motes of light. #}
    <g class="arena-keyart__embers" fill="#FFFFFF">
        {% for i in 0..17 %}
            <circle cx="{{ 600 + (i * 157) % 700 }}" cy="{{ 520 + (i * 61) % 300 }}" r="{{ 1 + (i % 3) * 0.6 }}" opacity="{{ 0.35 + (i % 4) * 0.15 }}"/>
        {% endfor %}
    </g>

    <rect y="700" width="1600" height="200" fill="url(#arena-keyart-fade)"/>
</svg>
