{% set summit_services = [
    {key: 'advice', url: path('sylius_shop_contact_request'), icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM15.5 8.5l-2 5-5 2 2-5z'},
    {key: 'returns', url: path('sylius_shop_account_dashboard'), icon: 'M4 12a8 8 0 0 1 14.6-4.5M19 4v3.5h-3.5M20 12a8 8 0 0 1-14.6 4.5M5 20v-3.5h3.5'},
    {key: 'repair', url: path('sylius_shop_contact_request'), icon: 'M14.5 6.5a4 4 0 0 0 5 5l-9 9a2 2 0 0 1-3-3l9-9a4 4 0 0 1 5-5l-2.5 2.5.5 2 2 .5z'},
] %}

<footer class="summit-footer">
    <div id="summit-services" class="summit-services">
        <div class="container">
            <div class="summit-services__head">
                <p class="summit-eyebrow summit-eyebrow--light">{{ 'summit.footer.services.eyebrow'|trans({}, 'summit') }}</p>
                <p class="summit-services__title">{{ 'summit.footer.services.title'|trans({}, 'summit')|raw }}</p>
            </div>

            <ul class="summit-services__items" role="list">
                {% for service in summit_services %}
                    <li class="summit-services__item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ service.icon }}"/></svg>
                        <p class="summit-services__name">{{ ('summit.footer.services.' ~ service.key ~ '.title')|trans({}, 'summit') }}</p>
                        <p class="summit-services__text">{{ ('summit.footer.services.' ~ service.key ~ '.text')|trans({}, 'summit') }}</p>
                        <a class="summit-link-arrow summit-link-arrow--light" href="{{ service.url }}">{{ ('summit.footer.services.' ~ service.key ~ '.cta')|trans({}, 'summit') }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container summit-footer__main">
        <div class="summit-footer__brand">
            {% include 'shop/shared/layout/brand/logo.html.twig' with {variant: 'footer'} %}
            <p>{{ 'summit.footer.tagline'|trans({}, 'summit') }}</p>
        </div>
        <div class="row">
            {% hook 'content' %}
        </div>
        <p class="summit-footer__notice">{{ 'summit.footer.notice'|trans({}, 'summit') }}</p>
    </div>
</footer>
