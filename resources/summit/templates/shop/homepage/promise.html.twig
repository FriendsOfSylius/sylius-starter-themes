{# Summit promise: four commitments of the store in a light band, each opened by an orange pictogram. #}
{% set summit_promises = [
    {key: 'tested', icon: 'M3 20l6-11 3 5 2-3 7 9zM9 9l1.6 3H7.4z'},
    {key: 'dispatch', icon: 'M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 1 0 0-.01M17 19a2 2 0 1 0 0-.01'},
    {key: 'returns', icon: 'M4 12a8 8 0 0 1 14.6-4.5M19 4v3.5h-3.5M20 12a8 8 0 0 1-14.6 4.5M5 20v-3.5h3.5'},
    {key: 'repair', icon: 'M14.5 6.5a4 4 0 0 0 5 5l-9 9a2 2 0 0 1-3-3l9-9a4 4 0 0 1 5-5l-2.5 2.5.5 2 2 .5z'},
] %}

<section id="summit-promise" class="summit-promise" aria-labelledby="summit-promise-title">
    <div class="container">
        <h2 id="summit-promise-title" class="visually-hidden">{{ 'summit.promise.title'|trans({}, 'summit') }}</h2>
        <ul class="summit-promise__items" role="list">
            {% for promise in summit_promises %}
                <li class="summit-promise__item">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ promise.icon }}"/></svg>
                    <div>
                        <p class="summit-promise__name">{{ ('summit.promise.' ~ promise.key ~ '.title')|trans({}, 'summit') }}</p>
                        <p class="summit-promise__text">{{ ('summit.promise.' ~ promise.key ~ '.text')|trans({}, 'summit') }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
