{# The Bloom vanity: an arched mirror opening onto a garden at sunrise (a lilac dusk and a moon in the dark scheme),
   pastel pedestals holding a perfume, a pot of cream and a dropper serum, peonies, a lipstick on the marble and
   falling petals. The product colours are the same in both schemes; the sky, the frame and the marble follow the
   palette through their classes. Stickers are printed over it, like on a gift box. #}
<figure class="bloom-vanity">
    <svg class="bloom-hero__panel" viewBox="0 0 440 540" role="img" aria-labelledby="bloom-vanity-title" focusable="false">
        <title id="bloom-vanity-title">{{ 'bloom.hero.illustration'|trans({}, 'bloom') }}</title>
        <defs>
            <linearGradient id="bloom-vanity-sky" x1="0" y1="0" x2="0" y2="1">
                <stop class="bloom-vanity__sky-top" offset="0"/>
                <stop class="bloom-vanity__sky-bottom" offset="0.85"/>
            </linearGradient>
            <radialGradient id="bloom-vanity-halo">
                <stop class="bloom-vanity__halo-stop" offset="0" stop-opacity="0.85"/>
                <stop class="bloom-vanity__halo-stop" offset="1" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="bloom-vanity-juice" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#FBD0C0"/>
                <stop offset="1" stop-color="#F59A8E"/>
            </linearGradient>
            <linearGradient id="bloom-vanity-amber" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#E9A04E"/>
                <stop offset="1" stop-color="#B8641F"/>
            </linearGradient>
            <clipPath id="bloom-vanity-arch">
                <path d="M44 540V200a176 176 0 0 1 352 0v340z"/>
            </clipPath>
            {# A peony: two rings of round petals around a deeper heart. #}
            <symbol id="bloom-vanity-peony" viewBox="-30 -30 60 60">
                <g fill="#F8B4C8">
                    <circle cx="0" cy="-15" r="13"/><circle cx="13" cy="-7.5" r="13"/><circle cx="13" cy="7.5" r="13"/>
                    <circle cx="0" cy="15" r="13"/><circle cx="-13" cy="7.5" r="13"/><circle cx="-13" cy="-7.5" r="13"/>
                </g>
                <g fill="#F28AA8">
                    <circle cx="0" cy="-7" r="9"/><circle cx="6" cy="3.5" r="9"/><circle cx="-6" cy="3.5" r="9"/>
                </g>
                <circle r="6.5" fill="#E2557F"/>
                <circle cx="-2" cy="-2" r="2.2" fill="#FFF9F5" opacity="0.55"/>
            </symbol>
            <path id="bloom-vanity-sparkle" d="M0-10C1-2 2-1 10 0 2 1 1 2 0 10-1 2-2 1-10 0-2-1-1-2 0-10z"/>
            <ellipse id="bloom-vanity-petal" rx="6" ry="3.6"/>
        </defs>

        {# The arched mirror and the garden behind it. #}
        <path class="bloom-vanity__frame" d="M28 540V196a192 192 0 0 1 384 0v344z"/>
        <path d="M44 540V200a176 176 0 0 1 352 0v340z" fill="url(#bloom-vanity-sky)"/>
        <g clip-path="url(#bloom-vanity-arch)">
            <circle cx="296" cy="150" r="104" fill="url(#bloom-vanity-halo)"/>
            <circle class="bloom-vanity__sun" cx="296" cy="150" r="46"/>
            <path class="bloom-vanity__hill bloom-vanity__hill--far" d="M44 352c46-34 92-40 140-22s96 14 132-8 60-16 80-6v224H44z"/>
            <path class="bloom-vanity__hill" d="M44 392c40-26 96-30 150-10s110 16 152-6c22-12 38-10 50-4v168H44z"/>
            <g class="bloom-vanity__birds" fill="none" stroke-linecap="round" stroke-width="2">
                <path d="M118 120q7-7 14 0 7-7 14 0"/>
                <path d="M152 96q5-5 10 0 5-5 10 0"/>
            </g>
        </g>
        <path class="bloom-vanity__frame-line" d="M44 540V200a176 176 0 0 1 352 0v340"/>

        {# Peonies leaning out of the left of the mirror, and a bud on the right. #}
        <g class="bloom-vanity__bouquet">
            <path d="M120 470C104 380 76 320 54 252M120 470c4-110 14-200 52-282M120 470c20-70 52-118 98-156" fill="none" stroke="#6E9A72" stroke-width="3" stroke-linecap="round"/>
            <g fill="#8DB58D">
                <ellipse cx="76" cy="326" rx="22" ry="9" transform="rotate(-50 76 326)"/>
                <ellipse cx="140" cy="292" rx="24" ry="9" transform="rotate(-70 140 292)"/>
                <ellipse cx="190" cy="334" rx="22" ry="8" transform="rotate(-25 190 334)"/>
                <ellipse cx="98" cy="388" rx="18" ry="8" transform="rotate(40 98 388)"/>
            </g>
            <use href="#bloom-vanity-peony" x="4" y="196" width="104" height="104"/>
            <use href="#bloom-vanity-peony" x="128" y="140" width="86" height="86"/>
            <use href="#bloom-vanity-peony" x="186" y="270" width="64" height="64"/>
        </g>
        <g class="bloom-vanity__bud">
            <path d="M392 400c-2-40 4-70 14-96" fill="none" stroke="#6E9A72" stroke-width="2.5" stroke-linecap="round"/>
            <ellipse cx="404" cy="350" rx="14" ry="6" fill="#8DB58D" transform="rotate(-60 404 350)"/>
            <use href="#bloom-vanity-peony" x="382" y="270" width="50" height="50"/>
        </g>

        {# The marble vanity. #}
        <rect class="bloom-vanity__marble" x="0" y="470" width="440" height="70"/>
        <path class="bloom-vanity__vein" d="M12 512c40-10 70 6 110-4s70-18 118-6M268 530c30-8 60-2 90-10s48-6 70 0" fill="none" stroke-width="1.2"/>
        <rect class="bloom-vanity__marble-edge" x="0" y="470" width="440" height="4"/>

        {# Pastel pedestals: a sage column, a butter disc, a lilac block. #}
        <g>
            <rect x="62" y="364" width="110" height="110" fill="#A9C6A2"/>
            <ellipse cx="117" cy="474" rx="55" ry="10" fill="#93B38C"/>
            <rect x="62" y="364" width="18" height="110" fill="#FFF9F5" opacity="0.22"/>
            <ellipse cx="117" cy="364" rx="55" ry="11" fill="#C3DABD"/>

            <rect x="290" y="392" width="100" height="82" rx="4" fill="#CDB8EC"/>
            <rect x="290" y="392" width="100" height="10" rx="4" fill="#DDCDF3"/>
            <rect x="374" y="392" width="16" height="82" fill="#B6A0D9"/>

            <rect x="182" y="436" width="96" height="38" fill="#F6DF97"/>
            <ellipse cx="230" cy="474" rx="48" ry="8" fill="#E8CC79"/>
            <ellipse cx="230" cy="436" rx="48" ry="9" fill="#FBEBB8"/>
        </g>

        {# A perfume with a peony cap on the sage column. #}
        <g class="bloom-vanity__perfume">
            <rect x="86" y="262" width="62" height="100" rx="12" fill="#FFF9F5" opacity="0.7"/>
            <rect x="91" y="286" width="52" height="72" rx="8" fill="url(#bloom-vanity-juice)"/>
            <rect x="96" y="270" width="6" height="84" rx="3" fill="#FFF9F5" opacity="0.75"/>
            <rect x="106" y="312" width="22" height="22" rx="11" fill="#FFF9F5" opacity="0.85"/>
            <use href="#bloom-vanity-sparkle" transform="translate(117 323) scale(0.6)" fill="#E2557F"/>
            <rect x="107" y="246" width="20" height="18" rx="3" fill="#D9B26A"/>
            <circle cx="117" cy="226" r="22" fill="#E2557F"/>
            <circle cx="117" cy="226" r="22" fill="none" stroke="#B02A5B" stroke-width="1.5" opacity="0.45"/>
            <ellipse cx="109" cy="217" rx="7" ry="5" fill="#FFF9F5" opacity="0.55"/>
        </g>

        {# A pot of cream on the butter disc, its lid propped against it. #}
        <g class="bloom-vanity__cream">
            <rect x="196" y="392" width="62" height="44" rx="12" fill="#F8C6D3"/>
            <path d="M200 394c8-12 18-14 27-6 9-10 21-8 27 4z" fill="#FFF9F5"/>
            <rect x="196" y="408" width="62" height="14" fill="#FFF9F5" opacity="0.75"/>
            <circle cx="227" cy="415" r="4" fill="#E2557F"/>
            <rect x="202" y="396" width="5" height="34" rx="2.5" fill="#FFF9F5" opacity="0.55"/>
            <rect x="248" y="404" width="44" height="14" rx="6" fill="#E2557F" transform="rotate(68 270 411)"/>
        </g>

        {# A dropper serum on the lilac block. #}
        <g class="bloom-vanity__serum">
            <rect x="314" y="322" width="52" height="70" rx="10" fill="url(#bloom-vanity-amber)"/>
            <rect x="320" y="346" width="40" height="28" rx="3" fill="#FFF9F5"/>
            <rect x="326" y="352" width="28" height="3" rx="1.5" fill="#B02A5B"/>
            <rect x="326" y="359" width="18" height="2" rx="1" fill="#2A1024" opacity="0.5"/>
            <rect x="320" y="328" width="5" height="56" rx="2.5" fill="#FFF9F5" opacity="0.45"/>
            <rect x="327" y="306" width="26" height="18" rx="3" fill="#D9B26A"/>
            <rect x="331" y="272" width="18" height="36" rx="9" fill="#2A1024"/>
            <rect x="335" y="278" width="4" height="20" rx="2" fill="#FFF9F5" opacity="0.3"/>
        </g>

        {# A lipstick and its cap lying on the marble, and petals fallen around them. #}
        <g class="bloom-vanity__lipstick">
            <rect x="300" y="494" width="58" height="20" rx="4" fill="#2A1024"/>
            <rect x="350" y="494" width="8" height="20" fill="#D9B26A"/>
            <path d="M358 497h20l14 6v8h-34z" fill="#B02A5B"/>
            <rect x="244" y="500" width="44" height="20" rx="4" fill="#2A1024" transform="rotate(-8 266 510)"/>
            <rect x="244" y="500" width="6" height="20" fill="#D9B26A" transform="rotate(-8 266 510)"/>
        </g>
        <g fill="#F8B4C8">
            <use href="#bloom-vanity-petal" x="64" y="500" transform="rotate(-20 64 500)"/>
            <use href="#bloom-vanity-petal" x="180" y="514" transform="rotate(30 180 514)"/>
            <use href="#bloom-vanity-petal" x="410" y="506" transform="rotate(-40 410 506)"/>
        </g>

        {# Falling petals and twinkling sparkles. #}
        <g class="bloom-vanity__falling" fill="#F28AA8">
            <use href="#bloom-vanity-petal" x="210" y="120"/>
            <use href="#bloom-vanity-petal" x="250" y="60"/>
            <use href="#bloom-vanity-petal" x="360" y="180"/>
        </g>
        <g class="bloom-vanity__sparkles">
            <use href="#bloom-vanity-sparkle" x="232" y="236"/>
            <use href="#bloom-vanity-sparkle" x="384" y="276"/>
            <use href="#bloom-vanity-sparkle" x="70" y="140"/>
            <use href="#bloom-vanity-sparkle" x="178" y="404"/>
        </g>
    </svg>

    <div class="bloom-stickers" aria-hidden="true">
        <span class="bloom-sticker bloom-sticker--vegan">{{ 'bloom.hero.sticker_vegan'|trans({}, 'bloom')|raw }}</span>
        <span class="bloom-sticker bloom-sticker--ingredient">{{ 'bloom.hero.sticker_ingredient'|trans({}, 'bloom')|raw }}</span>
        <span class="bloom-sticker bloom-sticker--refill">{{ 'bloom.hero.sticker_refill'|trans({}, 'bloom') }}</span>
    </div>
</figure>
