{# The Bloom vanity: a photograph in an arched mirror, of pastel pedestals holding a perfume, a pot of cream and a
   dropper serum among peonies on a marble vanity, in the morning sun in the light scheme and at dusk, by candlelight,
   in the dark one. Stickers are printed over it, like on a gift box. #}
<figure class="bloom-vanity">
    <div class="bloom-hero__panel bloom-hero__photo" role="img" aria-label="{{ 'bloom.hero.illustration'|trans({}, 'bloom') }}"></div>

    <div class="bloom-stickers" aria-hidden="true">
        <span class="bloom-sticker bloom-sticker--vegan">{{ 'bloom.hero.sticker_vegan'|trans({}, 'bloom')|raw }}</span>
        <span class="bloom-sticker bloom-sticker--ingredient">{{ 'bloom.hero.sticker_ingredient'|trans({}, 'bloom')|raw }}</span>
        <span class="bloom-sticker bloom-sticker--refill">{{ 'bloom.hero.sticker_refill'|trans({}, 'bloom') }}</span>
    </div>
</figure>
