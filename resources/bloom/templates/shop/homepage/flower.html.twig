{# The house flower: five round petals in the colours of the shelves (skincare peony, makeup apricot, fragrance butter,
   hair sage, wellness lilac) around a fig heart. #}
<svg class="bloom-flower {{ class|default('') }}" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <g class="bloom-flower__petals">
        <circle class="bloom-flower__petal--1" cx="20" cy="11.2" r="7.4"/>
        <circle class="bloom-flower__petal--2" cx="28.4" cy="17.3" r="7.4"/>
        <circle class="bloom-flower__petal--3" cx="25.2" cy="27.1" r="7.4"/>
        <circle class="bloom-flower__petal--4" cx="14.8" cy="27.1" r="7.4"/>
        <circle class="bloom-flower__petal--5" cx="11.6" cy="17.3" r="7.4"/>
    </g>
    <circle class="bloom-flower__heart" cx="20" cy="20.4" r="4.6"/>
</svg>
