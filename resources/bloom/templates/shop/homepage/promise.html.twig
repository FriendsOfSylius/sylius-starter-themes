{# Bloom promise, presented as a ritual: the routine in three steps, next to a ritual card for one skin type, with the texture of each step. #}
<section id="bloom-ritual" class="bloom-ritual" aria-labelledby="bloom-ritual-title">
    <div class="container">
        <div class="bloom-ritual__grid">
            <div class="bloom-ritual__steps">
                <div class="bloom-section-head">
                    <p class="bloom-eyebrow">{{ 'bloom.ritual.eyebrow'|trans({}, 'bloom') }}</p>
                    <h2 id="bloom-ritual-title">{{ 'bloom.ritual.title'|trans({}, 'bloom')|raw }}</h2>
                    <p class="bloom-section-head__lead">{{ 'bloom.ritual.lead'|trans({}, 'bloom')|raw }}</p>
                </div>

                <ol class="bloom-steps" role="list">
                    {% for step in 1..3 %}
                        <li class="bloom-steps__item bloom-steps__item--{{ step }}">
                            <span class="bloom-steps__numeral" aria-hidden="true">{{ step }}</span>
                            <div>
                                <p class="bloom-steps__title">{{ ('bloom.ritual.step_' ~ step ~ '.title')|trans({}, 'bloom') }}</p>
                                <p class="bloom-steps__text">{{ ('bloom.ritual.step_' ~ step ~ '.text')|trans({}, 'bloom') }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            </div>

            <aside class="bloom-card" aria-labelledby="bloom-card-title">
                <div class="bloom-card__label">
                    {% include 'shop/homepage/flower.html.twig' with {class: 'bloom-card__flower'} %}
                    <p class="bloom-card__kicker">{{ 'bloom.ritual.card.kicker'|trans({}, 'bloom') }}</p>
                    <p id="bloom-card-title" class="bloom-card__title">{{ 'bloom.ritual.card.title'|trans({}, 'bloom') }}</p>
                    <p class="bloom-card__time">{{ 'bloom.ritual.card.time'|trans({}, 'bloom') }}</p>

                    {# One swatch per step: a gel, a serum drop and a swirl of cream. #}
                    <ul class="bloom-swatches" role="list">
                        {% for swatch in ['gel', 'serum', 'cream'] %}
                            <li class="bloom-swatch bloom-swatch--{{ swatch }}">
                                <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                                    {% if swatch == 'gel' %}
                                        <path class="bloom-swatch__fill" d="M10 38c0-12 10-20 22-20s22 6 22 18-9 18-22 18S10 50 10 38z"/>
                                        <ellipse class="bloom-swatch__shine" cx="24" cy="30" rx="6" ry="3.5"/>
                                    {% elseif swatch == 'serum' %}
                                        <path class="bloom-swatch__fill" d="M32 8c8 12 16 21 16 31a16 16 0 0 1-32 0c0-10 8-19 16-31z"/>
                                        <ellipse class="bloom-swatch__shine" cx="26" cy="40" rx="3.5" ry="6"/>
                                    {% else %}
                                        <path class="bloom-swatch__fill" d="M8 44c2-10 12-14 18-12 0-8 10-14 18-10 6 3 8 9 6 13 6 1 9 6 7 10-2 6-10 8-24 8S6 52 8 44z"/>
                                        <path class="bloom-swatch__swirl" d="M24 40c4-6 14-6 16 0"/>
                                    {% endif %}
                                </svg>
                                <span class="bloom-swatch__name">{{ ('bloom.ritual.card.' ~ swatch)|trans({}, 'bloom') }}</span>
                            </li>
                        {% endfor %}
                    </ul>

                    <dl class="bloom-card__notes">
                        {% for note in ['skin', 'ingredients', 'finish'] %}
                            <div>
                                <dt>{{ ('bloom.ritual.card.' ~ note ~ '.label')|trans({}, 'bloom') }}</dt>
                                <dd>{{ ('bloom.ritual.card.' ~ note ~ '.value')|trans({}, 'bloom') }}</dd>
                            </div>
                        {% endfor %}
                    </dl>

                    {% include 'shop/homepage/texture_scale.html.twig' with {level: 2} %}
                </div>
            </aside>
        </div>
    </div>
</section>
