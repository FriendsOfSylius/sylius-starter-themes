{% set brand = storefront_brand() %}
{% if brand.logo %}
    <img class="cellar-logo__image" src="{{ brand.logo }}" alt="{{ brand.logoAlt ?? brand.name ?? '' }}">
{% else %}
    {# A grape cluster seal, drawn in fine lines, next to a Didone wordmark. #}
    <svg class="cellar-logo__seal" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <circle class="cellar-logo__ring" cx="20" cy="20" r="18.5"/>
        <path class="cellar-logo__stem" d="M20 8.5v4M20 10.5c2.2-2.6 5.2-3.2 7.6-2.2-1 2.6-3.8 3.9-7.6 2.2"/>
        <g class="cellar-logo__grapes">
            <circle cx="15.2" cy="16.4" r="2.7"/>
            <circle cx="20.6" cy="16.4" r="2.7"/>
            <circle cx="26" cy="16.4" r="2.7"/>
            <circle cx="17.9" cy="21.1" r="2.7"/>
            <circle cx="23.3" cy="21.1" r="2.7"/>
            <circle cx="20.6" cy="25.8" r="2.7"/>
            <circle cx="20.6" cy="30.3" r="2.1"/>
        </g>
    </svg>
    <span class="cellar-logo__text">
        <span class="cellar-logo__name">Cellar</span>
        <span class="cellar-logo__tagline">{{ 'cellar.brand.tagline'|trans({}, 'cellar') }}</span>
    </span>
{% endif %}
