{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

<div class="col-auto position-relative culture-cart" {{ attributes }}>
    <div data-loading>
        <div class="sylius-shop-loader">
            <img src="{{ asset('build/shop/images/loader.gif', 'shop') }}" alt="{{ 'sylius.ui.loading'|trans }}" loading="lazy"/>
        </div>
    </div>
    <div {{ sylius_test_html_attribute('cart-button') }}>
        <button class="btn culture-cart__button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasCart" aria-label="{{ 'sylius.ui.cart'|trans }}">
            <svg class="culture-cart__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/>
                <circle cx="10" cy="20.5" r="1.2"/>
                <circle cx="17" cy="20.5" r="1.2"/>
            </svg>
            <span class="d-none d-lg-inline" {{ sylius_test_html_attribute('cart-total') }}>
                {{- money.convertAndFormat(cart.itemsTotal) -}}
            </span>
            {% if cart.totalQuantity > 0 %}
                <span class="culture-cart__count" {{ sylius_test_html_attribute('cart-quantity', cart.totalQuantity) }}>
                    {{ cart.totalQuantity }}
                </span>
            {% endif %}
        </button>
    </div>
</div>
