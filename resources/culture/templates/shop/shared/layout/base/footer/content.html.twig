{% set culture_services = [
    {key: 'delivery', icon: 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'},
    {key: 'returns', icon: 'M9 14 4 9l5-5M4 9h10.5a5.5 5.5 0 0 1 0 11H11'},
    {key: 'payment', icon: 'M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6zM8.5 12l2.5 2.5 4.5-5'},
    {key: 'support', icon: 'M4 14v-2a8 8 0 0 1 16 0v2M4 14h3v5H5a1 1 0 0 1-1-1zM20 14h-3v5h2a1 1 0 0 0 1-1zM17 19c0 1.5-2 2-5 2'},
] %}

<footer class="culture-footer">
    {# The reassurance band: four promises of the store, on a light grey band. #}
    <div class="culture-reassurance">
        <div class="container">
            <ul class="culture-reassurance__items" role="list">
                {% for service in culture_services %}
                    <li class="culture-reassurance__item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ service.icon }}"/></svg>
                        <p>
                            <span class="culture-reassurance__title">{{ ('culture.footer.services.' ~ service.key ~ '.title')|trans({}, 'culture') }}</span>
                            <span class="culture-reassurance__text">{{ ('culture.footer.services.' ~ service.key ~ '.text')|trans({}, 'culture') }}</span>
                        </p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container culture-footer__main">
        <div class="culture-footer__brand">
            {% include 'shop/shared/layout/brand/logo.html.twig' with {variant: 'footer'} %}
            <p>{{ 'culture.footer.tagline'|trans({}, 'culture') }}</p>
        </div>
        <div class="row">
            {% hook 'content' %}
        </div>
        <p class="culture-footer__notice">{{ 'culture.footer.notice'|trans({}, 'culture') }}</p>
    </div>
</footer>
