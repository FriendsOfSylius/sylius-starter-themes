{% set brand = storefront_brand() %}
{% if brand.logo %}
    <img class="tech-logo__image" src="{{ brand.logo }}" alt="{{ brand.logoAlt ?? brand.name ?? '' }}">
{% else %}
    <svg class="tech-logo__chip" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path class="tech-logo__pins" d="M11 2v5M16 2v5M21 2v5M11 25v5M16 25v5M21 25v5M2 11h5M2 16h5M2 21h5M25 11h5M25 16h5M25 21h5"/>
        <rect class="tech-logo__die" x="7" y="7" width="18" height="18" rx="3"/>
        <rect class="tech-logo__core" x="12.5" y="12.5" width="7" height="7" rx="1"/>
    </svg>
    <span class="tech-logo__name">Tech</span>
{% endif %}
