{% set tech_services = [
    {key: 'support', url: path('sylius_shop_contact_request'), icon: 'M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2zM20 14a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2zM17 16v1a3 3 0 0 1-3 3h-2'},
    {key: 'warranty', url: path('sylius_shop_account_dashboard'), icon: 'M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6zM9 12l2 2 4-4'},
    {key: 'returns', url: path('sylius_shop_account_dashboard'), icon: 'M4 12a8 8 0 1 0 2.35-5.65M4 4v4h4'},
] %}

<footer class="tech-footer">
    <div id="tech-services" class="tech-services">
        <div class="container">
            <div class="tech-services__head">
                <p class="tech-eyebrow">{{ 'tech.footer.services.eyebrow'|trans({}, 'tech') }}</p>
                <p class="tech-services__title">{{ 'tech.footer.services.title'|trans({}, 'tech') }}</p>
            </div>

            <ul class="tech-services__cards" role="list">
                {% for service in tech_services %}
                    <li class="tech-services__card">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ service.icon }}"/></svg>
                        <p class="tech-services__tag">{{ ('tech.footer.services.' ~ service.key ~ '.tag')|trans({}, 'tech') }}</p>
                        <p class="tech-services__name">{{ ('tech.footer.services.' ~ service.key ~ '.title')|trans({}, 'tech') }}</p>
                        <p class="tech-services__text">{{ ('tech.footer.services.' ~ service.key ~ '.text')|trans({}, 'tech') }}</p>
                        <a class="tech-services__link" href="{{ service.url }}">{{ ('tech.footer.services.' ~ service.key ~ '.cta')|trans({}, 'tech') }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container tech-footer__main">
        <div class="tech-footer__brand">
            {% include 'shop/shared/layout/brand/logo.html.twig' with {variant: 'footer'} %}
            <p>{{ 'tech.footer.tagline'|trans({}, 'tech') }}</p>
        </div>
        <div class="row">
            {% hook 'content' %}
        </div>
    </div>
</footer>
