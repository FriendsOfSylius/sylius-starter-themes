{% set brand = storefront_brand() %}
{% if brand.logo %}
    <img class="rg-logo__image" src="{{ brand.logo }}" alt="{{ brand.logoAlt ?? brand.name ?? '' }}">
{% else %}
    <svg class="rg-logo__pad" viewBox="0 0 13 8" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
        <path class="rg-logo__pad-body" d="M2 0h9v1h1v1h1v5h-1v1h-3v-1h-1v-1h-3v1h-1v1h-3v-1h-1v-5h1v-1h1z"/>
        <path class="rg-logo__pad-key" d="M3 2h1v1h1v1h-1v1h-1v-1h-1v-1h1z"/>
        <path class="rg-logo__pad-a" d="M9 2h1v1h-1z"/>
        <path class="rg-logo__pad-b" d="M10 3h1v1h-1z"/>
    </svg>
    <span class="rg-logo__name">Retro<span>Gaming</span></span>
{% endif %}
