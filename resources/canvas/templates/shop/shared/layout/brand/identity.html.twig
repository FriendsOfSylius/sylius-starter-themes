{% set brand = storefront_brand() %}
{% if brand.logo %}
    <img class="canvas-logo__image" src="{{ brand.logo }}" alt="{{ brand.logoAlt ?? brand.name ?? '' }}">
{% else %}
    <svg class="canvas-logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect class="canvas-logo__mark-bg" width="48" height="48"/>
        <path class="canvas-logo__mark-letter" d="M32 14H22a10 10 0 1 0 0 20h10"/>
    </svg>
    <span class="canvas-logo__name">CANVAS</span>
{% endif %}
