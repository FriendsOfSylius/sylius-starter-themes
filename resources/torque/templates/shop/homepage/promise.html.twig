{# Torque promise: the trade price band, the unit price of a set of brake pads falling at each quantity step, then
   the four promises of the counter in a row. #}
<section id="torque-promise" class="torque-promise" aria-labelledby="torque-breaks-title">
    <div class="container">
        <div class="torque-breaks">
            <svg class="torque-breaks__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path d="m24 4 10 5v10l-10 5-10-5V9z"/><path d="m14 9 10 5 10-5M24 14v10"/>
                <path d="m14 24 10 5v10l-10 5-10-5V29z"/><path d="m4 29 10 5 10-5M14 34v10"/>
                <path d="m34 24 10 5v10l-10 5-10-5V29z"/><path d="m24 29 10 5 10-5M34 34v10"/>
            </svg>
            <h2 id="torque-breaks-title" class="torque-breaks__title">{{ 'torque.breaks.title'|trans({}, 'torque') }}</h2>
            <p class="torque-breaks__lead">
                {{ 'torque.breaks.lead'|trans({}, 'torque') }}
                <a class="torque-link-arrow" href="#torque-account">{{ 'torque.breaks.cta'|trans({}, 'torque') }}</a>
            </p>
            <table class="torque-breaks__table">
                <caption class="visually-hidden">{{ 'torque.breaks.caption'|trans({}, 'torque') }}</caption>
                <tbody>
                    <tr>
                        {% for tier in 1..4 %}
                            <td class="torque-breaks__tier{{ tier == 2 ? ' is-current' : '' }}"{% if tier == 2 %} aria-current="true"{% endif %}>
                                <span class="torque-breaks__qty">{{ ('torque.breaks.tier_' ~ tier ~ '.qty')|trans({}, 'torque') }}</span>
                                <span class="torque-breaks__price">{{ ('torque.breaks.tier_' ~ tier ~ '.price')|trans({}, 'torque') }}</span>
                            </td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>

        <ul class="torque-benefits" role="list">
            {% for benefit in [
                {key: 'quality', icon: 'M12 3 19 6v5c0 5-3 8-7 10-4-2-7-5-7-10V6zM9 12l2 2 4-4'},
                {key: 'fitment', icon: 'M5 11l1.6-4.2A2 2 0 0 1 8.5 5.5h7a2 2 0 0 1 1.9 1.3L19 11M3.5 11h17v5.5h-17zM5.5 16.5V19M18.5 16.5V19'},
                {key: 'delivery', icon: 'M3 7h11v9H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'},
                {key: 'warranty', icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2'},
            ] %}
                <li class="torque-benefits__item">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ benefit.icon }}"/></svg>
                    <div>
                        <p class="torque-benefits__title">{{ ('torque.benefits.' ~ benefit.key ~ '.title')|trans({}, 'torque') }}</p>
                        <p class="torque-benefits__text">{{ ('torque.benefits.' ~ benefit.key ~ '.text')|trans({}, 'torque') }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
