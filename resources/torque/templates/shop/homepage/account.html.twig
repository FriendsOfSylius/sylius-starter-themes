{# The trade account: how it works in three steps, next to the account card of a fictional customer, with its terms
   and its savings on the last order. #}
<section id="torque-account" class="torque-account" aria-labelledby="torque-account-title">
    <div class="container">
        <div class="torque-account__grid">
            <div class="torque-account__steps">
                <div class="torque-section-head">
                    <p class="torque-eyebrow">{{ 'torque.account.eyebrow'|trans({}, 'torque') }}</p>
                    <h2 id="torque-account-title">{{ 'torque.account.title'|trans({}, 'torque')|raw }}</h2>
                    <p class="torque-section-head__lead">{{ 'torque.account.lead'|trans({}, 'torque')|raw }}</p>
                </div>

                <ol class="torque-steps" role="list">
                    {% for step in 1..3 %}
                        <li class="torque-steps__item">
                            <span class="torque-steps__numeral" aria-hidden="true">{{ '%02d'|format(step) }}</span>
                            <div>
                                <p class="torque-steps__title">{{ ('torque.account.step_' ~ step ~ '.title')|trans({}, 'torque') }}</p>
                                <p class="torque-steps__text">{{ ('torque.account.step_' ~ step ~ '.text')|trans({}, 'torque') }}</p>
                            </div>
                        </li>
                    {% endfor %}
                </ol>

                <a class="btn btn-primary" href="{{ path('sylius_shop_register') }}">{{ 'torque.account.cta'|trans({}, 'torque') }}</a>
            </div>

            <aside class="torque-card" aria-labelledby="torque-card-title">
                <div class="torque-card__head">
                    {% include 'shop/homepage/mark.html.twig' with {class: 'torque-card__mark'} %}
                    <div>
                        <p class="torque-card__kicker">{{ 'torque.account.card.kicker'|trans({}, 'torque') }}</p>
                        <p id="torque-card-title" class="torque-card__title">{{ 'torque.account.card.title'|trans({}, 'torque') }}</p>
                    </div>
                    <span class="torque-card__status">{{ 'torque.account.card.status'|trans({}, 'torque') }}</span>
                </div>

                <dl class="torque-card__terms">
                    {% for term in ['payment', 'credit', 'users', 'delivery'] %}
                        <div>
                            <dt>{{ ('torque.account.card.' ~ term ~ '.label')|trans({}, 'torque') }}</dt>
                            <dd>{{ ('torque.account.card.' ~ term ~ '.value')|trans({}, 'torque') }}</dd>
                        </div>
                    {% endfor %}
                </dl>


                <p class="torque-card__saving">{{ 'torque.account.card.saving'|trans({}, 'torque')|raw }}</p>
            </aside>
        </div>
    </div>
</section>
