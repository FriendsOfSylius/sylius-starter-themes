{# Two offer banners under the departments: the OE quality promise on the navy band, with a brake disc, and the
   trade price breaks on a pale panel, with a stack of tyres and the house slashes. #}
<section id="torque-offers" class="torque-offers" aria-label="{{ 'torque.offers.label'|trans({}, 'torque') }}">
    <div class="container">
        <div class="torque-offers__items">
            <div class="torque-offer torque-offer--quality">
                <svg class="torque-offer__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 4 40 10v12c0 10-7 18-16 22C15 40 8 32 8 22V10z"/><path d="m16 24 6 6 11-12"/></svg>
                <div class="torque-offer__body">
                    <h2 class="torque-offer__title">{{ 'torque.offers.quality.title'|trans({}, 'torque') }}</h2>
                    <p class="torque-offer__text">{{ 'torque.offers.quality.text'|trans({}, 'torque') }}</p>
                    <a class="torque-link-arrow torque-link-arrow--light" href="#torque-promise">{{ 'torque.offers.quality.cta'|trans({}, 'torque') }}</a>
                </div>
            </div>
            <div class="torque-offer torque-offer--trade">
                <svg class="torque-offer__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M6 8h18l18 18-16 16L8 24z"/><circle cx="16" cy="16" r="3"/></svg>
                <div class="torque-offer__body">
                    <h2 class="torque-offer__title">{{ 'torque.offers.trade.title'|trans({}, 'torque') }}</h2>
                    <p class="torque-offer__text">{{ 'torque.offers.trade.text'|trans({}, 'torque') }}</p>
                    <a class="torque-link-arrow" href="#torque-account">{{ 'torque.offers.trade.cta'|trans({}, 'torque') }}</a>
                </div>
            </div>
        </div>
    </div>
</section>
