{% set torque_services = [
    {key: 'delivery', url: path('sylius_shop_account_dashboard'), icon: 'M2 6h12v10H2zM14 9h4l3 3v4h-7zM6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4z'},
    {key: 'hotline', url: path('sylius_shop_contact_request'), icon: 'M4 14v-2a8 8 0 0 1 16 0v2M4 14h3v5H5a1 1 0 0 1-1-1zM20 14h-3v5h2a1 1 0 0 0 1-1z'},
    {key: 'returns', url: path('sylius_shop_account_dashboard'), icon: 'M4 9h12a4 4 0 0 1 0 8H9M4 9l4-4M4 9l4 4'},
] %}

<footer class="torque-footer">
    <div id="torque-services" class="torque-services">
        <div class="container">
            <div class="torque-services__head">
                <p class="torque-eyebrow torque-eyebrow--light">{{ 'torque.footer.services.eyebrow'|trans({}, 'torque') }}</p>
                <p class="torque-services__title">{{ 'torque.footer.services.title'|trans({}, 'torque')|raw }}</p>
            </div>

            <ul class="torque-services__items" role="list">
                {% for service in torque_services %}
                    <li class="torque-services__item">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="{{ service.icon }}"/></svg>
                        <p class="torque-services__name">{{ ('torque.footer.services.' ~ service.key ~ '.title')|trans({}, 'torque') }}</p>
                        <p class="torque-services__text">{{ ('torque.footer.services.' ~ service.key ~ '.text')|trans({}, 'torque') }}</p>
                        <a class="torque-link-arrow torque-link-arrow--light" href="{{ service.url }}">{{ ('torque.footer.services.' ~ service.key ~ '.cta')|trans({}, 'torque') }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <div class="container torque-footer__main">
        <div class="torque-footer__brand">
            {% include 'shop/shared/layout/brand/logo.html.twig' with {variant: 'footer'} %}
            <p>{{ 'torque.footer.tagline'|trans({}, 'torque') }}</p>
        </div>
        <div class="row">
            {% hook 'content' %}
        </div>
        <p class="torque-footer__notice">{{ 'torque.footer.notice'|trans({}, 'torque') }}</p>
    </div>
</footer>
